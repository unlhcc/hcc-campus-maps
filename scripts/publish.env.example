# Copy to ~/.config/hcc-campus-maps/publish.env on HCC and `chmod 600` it.
# Used by scripts/publish_departments.sh.

# RCF database (same values as the local .env)
RCF_MYSQL_HOST=
RCF_MYSQL_USER=
RCF_MYSQL_PASSWORD=
RCF_MYSQL_DATABASE_NAME=

# Private half of a GitHub deploy key with write access to this repo only
DEPLOY_KEY=$HOME/.ssh/hcc-campus-maps-deploy

# Python with the packages from scripts/requirements.txt (e.g. the hcc_campus_maps conda env)
PYTHON=$HOME/.conda/envs/hcc_campus_maps/bin/python

# Optional overrides
# REPO_URL=git@github.com:unlhcc/hcc-campus-maps.git
# BRANCH=main
# LOOKBACK_DAYS=14
# GIT_AUTHOR_NAME="HCC Campus Map Bot"
# GIT_AUTHOR_EMAIL=hcc-campus-map-bot@users.noreply.github.com
